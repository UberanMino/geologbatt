# Copy to .env and fill in for a `live` run (profile: live).
# The default `mock` profile needs NONE of these.

# Generator family (must differ from the Judge family)
ANTHROPIC_API_KEY=

# Judge / Scorer / Synthesizer family
OPENAI_API_KEY=

# Optional: Gemini as an alternative Judge family
GEMINI_API_KEY=

# Optional overrides (else config.yaml is used):
# GEO_PROFILE=live
# GEO_MODEL_GENERATOR=anthropic:claude-opus-5
# GEO_MODEL_JUDGE=openai:gpt-4.1
# GEO_MODEL_SCORER=openai:gpt-4o-mini
# GEO_MODEL_SYNTHESIZER=openai:gpt-4.1
