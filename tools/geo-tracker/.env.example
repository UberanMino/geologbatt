# GEO-Visibility-Tracker — Konfiguration.
#
# Kopie als `.env` anlegen und ausfüllen. `.env` ist in .gitignore und darf
# NIE committet werden. Alle Keys werden ausschließlich serverseitig gelesen;
# das Dashboard (Schritt 3) spricht nur mit unserer eigenen REST-API und
# bekommt niemals einen Provider-Key zu sehen.

# --- Secrets ---------------------------------------------------------------
# SearchApi (Ebene 1, Scraping der KI-Oberflächen): https://www.searchapi.io/
SEARCHAPI_API_KEY=

# Anthropic (Ebene 2, Auswertungs-Layer mit Claude Haiku 4.5).
# Für Schritt 1 nicht nötig — Ebene 1 läuft komplett ohne diesen Key.
ANTHROPIC_API_KEY=

# --- Speicher --------------------------------------------------------------
# Default: tools/geo-tracker/data/geotracker.sqlite3
GEOTRACKER_DB_PATH=

# --- Robustheit / Drosselung ----------------------------------------------
# Timeout je Request in Sekunden. Die KI-Oberflächen antworten langsam
# (10-60 s sind normal), deshalb großzügig.
GEOTRACKER_REQUEST_TIMEOUT=120

# Zusätzliche Versuche nach dem ersten, bei Netzwerkfehlern/429/5xx.
GEOTRACKER_MAX_RETRIES=3

# Basis für exponentielles Backoff in Sekunden (2 -> 2s, 4s, 8s).
GEOTRACKER_RETRY_BACKOFF=2

# Pause zwischen zwei Läufen. Läufe gehen bewusst sequenziell raus.
GEOTRACKER_THROTTLE_SECONDS=2

# Harte Kostenbremse: max. Läufe pro Aufruf von `ingest`.
# 79 Prompts x 4 Engines = 316 Läufe/Tag im Vollausbau.
GEOTRACKER_MAX_RUNS=200

# --- Engine-Optionen -------------------------------------------------------
# ChatGPT mit aktiver Websuche abfragen. Ohne Grounding liefert die Engine
# keine reference_links — dann gäbe es keine Citation-Analyse.
GEOTRACKER_CHATGPT_WEB_SEARCH=true

# Basis-URL der SearchApi (nur ändern, wenn ein Proxy davor hängt).
SEARCHAPI_BASE_URL=https://www.searchapi.io/api/v1/search
